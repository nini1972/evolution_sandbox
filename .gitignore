# Virtual Environment
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Config / Secrets
config/.env
.env
**/.env

# Large datasets & archive dumps
*.zip
*.tar.gz
*.tar
*.gz
*.7z
*.rar
*.h5
*.hdf5
*.parquet
*.pt
*.bin
*.npy
*.npz
*.sqlite3
*.db
AddBiomechanics/
**/AddBiomechanics/**

# OS files
.DS_Store
Thumbs.db

# Runtime state
instances/.expedition_state.json
# Job tickets
*.processed
# External World C checkout (root only — do NOT ignore instances/shared_space/world_c/)
/world_c/

# Prevent redundant multi-copy checkpoint state JSON bloat (canonical copies live in shared_space/world_c/stages/ and artifacts/<job_id>/)
instances/*/agent_workspace/*_state.json
instances/*/agent_workspace/world_c_results/*_state.json
instances/shared_space/world_c/artifacts/world_c_*_state.json
